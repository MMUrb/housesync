<?xml version="1.0" encoding="utf-8"?>
<!-- API <= 30 equivalent of data_extraction_rules.xml: exclude the WebView
     profile (auth session cookies) from Auto Backup. -->
<full-backup-content>
    <exclude domain="file" path="app_webview/" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
